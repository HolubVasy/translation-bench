OPENROUTER_API_KEY=sk-or-...

# PostgreSQL for the Translator interview app (AB#297).
# Copy to .env on the VPS and set a real password there. .env is gitignored
# and is the only place the connection string lives.
POSTGRES_DB=translation_bench
POSTGRES_USER=translation_bench
POSTGRES_PASSWORD=change-me

# Host port for the container. The VPS already runs other Postgres
# containers on 5432 and 5433, so this one takes 5434. Change it here if
# that is taken too; nothing in the code hardcodes a port.
DB_PORT=5434
DATABASE_URL=postgresql://translation_bench:change-me@127.0.0.1:5434/translation_bench

# Where db_backup.sh writes the daily dumps. Outside the repository.
BACKUP_DIR=/home/deploy/backups/translation-bench
